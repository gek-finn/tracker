# Task Tracker — пример конфигурации. Скопируйте в .env и заполните СВОИМИ
# значениями. Файл .env никогда не коммитится (см. .gitignore).
# На Railway эти переменные задаются в настройках сервиса, не файлом.

# Режим работы: local (по умолчанию) или production.
#   local      — сервер только на 127.0.0.1, пароль не обязателен
#               (если задан — защищает изменение данных, просмотр открыт);
#   production — ВЕСЬ интерфейс закрыт паролем администратора, кроме
#               /healthz. Без TRACKER_ADMIN_PASSWORD или TASK_TRACKER_SECRET
#               приложение НЕ ЗАПУСКАЕТСЯ (fail closed).
# Если не задан, среда Railway распознаётся автоматически.
TRACKER_ENV=local

# Секретный ключ Flask для сессий. В production ОБЯЗАТЕЛЕН.
# Сгенерируйте длинную случайную строку, например:
#   python -c "import secrets; print(secrets.token_hex(32))"
TASK_TRACKER_SECRET=change-me-to-a-long-random-string

# Пароль администратора (логин admin). В production ОБЯЗАТЕЛЕН.
# В production закрывает все страницы, API и экспорт.
# НЕ коммитите реальное значение — только переменные окружения платформы.
TRACKER_ADMIN_PASSWORD=set-a-strong-password

# Путь к файлу базы SQLite. На Railway — путь на постоянном томе.
TASK_TRACKER_DB=tasks.db

# Режим отладки: 1 только для локальной разработки.
# В production debug принудительно выключен (значение игнорируется).
TASK_TRACKER_DEBUG=0

# Порт и адрес локального запуска (production-порт задаёт платформа;
# в local-режиме сервер всегда слушает только 127.0.0.1).
TASK_TRACKER_PORT=5000
TASK_TRACKER_HOST=127.0.0.1

# Локально за HTTPS-прокси: cookie только по защищённому соединению.
# В production включается автоматически.
TRACKER_HTTPS=0

# Доверять заголовкам X-Forwarded-* от прокси. В production включается
# автоматически (Railway).
TRACKER_PROXY_FIX=0
